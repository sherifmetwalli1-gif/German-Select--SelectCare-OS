# ============================================================================
# SelectCareOS™ Telemedicine System - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Core Configuration
# ----------------------------------------------------------------------------

# App Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# OPTIONAL: Video Provider (Choose ONE)
# ----------------------------------------------------------------------------

# Option 1: Jitsi Meet (FREE - Default)
# No configuration needed! Works out of the box.
# Limitations: No cloud recording, no analytics

# Option 2: Daily.co (Premium Features)
# Sign up at: https://dashboard.daily.co
# Free tier: 10,000 minutes/month
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=your-subdomain.daily.co

# ----------------------------------------------------------------------------
# OPTIONAL: Database - Supabase (Recommended)
# ----------------------------------------------------------------------------
# Sign up at: https://supabase.com
# Free tier: 500MB database, unlimited API requests

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# OPTIONAL: Caching - Upstash Redis
# ----------------------------------------------------------------------------
# Sign up at: https://console.upstash.com
# Free tier: 10,000 commands/day

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ----------------------------------------------------------------------------
# OPTIONAL: Push Notifications - Firebase
# ----------------------------------------------------------------------------
# Sign up at: https://console.firebase.google.com
# Free tier: Unlimited push notifications

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_ADMIN_SDK_KEY={"type":"service_account",...}

# ----------------------------------------------------------------------------
# OPTIONAL: Email - SendGrid
# ----------------------------------------------------------------------------
# Sign up at: https://sendgrid.com
# Free tier: 100 emails/day

SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=SelectCareOS

# ----------------------------------------------------------------------------
# OPTIONAL: SMS - Twilio
# ----------------------------------------------------------------------------
# Sign up at: https://www.twilio.com
# Trial: $15 free credit

TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ----------------------------------------------------------------------------
# OPTIONAL: Payments - Stripe
# ----------------------------------------------------------------------------
# Sign up at: https://stripe.com
# Free tier: Pay per transaction (2.9% + $0.30)

STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ----------------------------------------------------------------------------
# OPTIONAL: AI Features - OpenAI
# ----------------------------------------------------------------------------
# Sign up at: https://platform.openai.com
# Pay per token

OPENAI_API_KEY=sk-your-openai-api-key

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------

# JWT Secret for API authentication (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-min-32-chars

# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ============================================================================
# COST BREAKDOWN (All Optional Services)
# ============================================================================
#
# Service          | Free Tier Limits           | Monthly Cost (0-1K users)
# -----------------|----------------------------|--------------------------
# Jitsi Meet       | Unlimited                  | €0
# Daily.co         | 10,000 min/month           | €0-€25
# Supabase         | 500MB + unlimited API      | €0
# Upstash Redis    | 10,000 commands/day        | €0
# Firebase FCM     | Unlimited                  | €0
# SendGrid         | 100 emails/day             | €0
# Vercel           | Unlimited bandwidth        | €0
# -----------------|----------------------------|--------------------------
# TOTAL            |                            | €0-€25/month
#
# ============================================================================
