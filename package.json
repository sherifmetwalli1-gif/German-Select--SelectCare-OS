{
  "name": "selectcareos",
  "version": "2.4.0",
  "description": "SelectCareOS - German Select Medical Tourism Platform with Telemedicine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name selectcareos-app",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name selectcareos-app --branch main",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply selectcareos-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply selectcareos-production",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop selectcareos",
    "restart": "pm2 restart selectcareos",
    "logs": "pm2 logs selectcareos --nostream",
    "test": "npm run test:api && npm run test:pages",
    "test:api": "./test-api.sh http://localhost:3000",
    "test:pages": "./test-pages.sh http://localhost:3000",
    "test:prod": "./test-api.sh https://selectcareos-app.pages.dev && ./test-pages.sh https://selectcareos-app.pages.dev",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:port": "fuser -k 3000/tcp 2>/dev/null || true",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "hono": "^4.11.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.18.2",
    "typescript": "^5.4.0",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
